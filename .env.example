# Copy this file to .env.local and fill in real values. Never commit .env.local —
# it's already excluded via .gitignore's `.env*.local` pattern.

# Plaid — Client ID is the same for sandbox/production; swap the secret + env + URL
# together when going live. Get these from Maury / 07_Credentials/PLAID_CREDENTIALS.txt.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# https://sandbox.plaid.com in dev, https://production.plaid.com at go-live — the
# `plaid` SDK picks the right base path from PLAID_ENV, this is only for reference.

# OAuth — must exactly match a redirect URI registered in the Plaid Dashboard.
# Registered URIs: https://touchofvintage.biz/oauth and https://www.touchofvintage.biz/oauth
# NOTE: OAuth-required banks (Chase, BofA, etc.) can only be tested end-to-end once
# deployed to one of those domains — Plaid won't accept a localhost redirect_uri here.
PLAID_REDIRECT_URI=https://touchofvintage.biz/oauth

# Supabase — create a free project at https://supabase.com, then run
# supabase/schema.sql in its SQL Editor. SERVICE_KEY (not the anon key!) is required
# for the backend to bypass Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# At-rest encryption for the Plaid access_token and bank account numbers stored in
# Supabase (GLBA/FCRA requirement). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up somewhere other than this file — losing it makes stored data
# permanently unreadable.
ENCRYPTION_KEY=

# LoanDisk — get all 4 from your account: Admin → Settings → API Settings
# (https://x.loandisk.com/admin/api/api_settings.php). AUTH_CODE is only ever shown in
# full once (right after clicking "Regenerate Auth Code") — LoanDisk masks it
# permanently after that, so save it somewhere safe the moment you generate it.
LOANDISK_API_BASE_URL=https://api-main.loandisk.com
LOANDISK_PUBLIC_KEY=
LOANDISK_AUTH_CODE=
LOANDISK_BRANCH_ID_CONSUMER=87409
LOANDISK_BRANCH_ID_COMMERCIAL=89035

# Payliance — loan disbursement (TOV → borrower, Credit) and repayment collection
# (borrower → TOV, Debit) via ACH. Replaced Stripe 2026-08-06 after Stripe closed TOV's
# account for good (lending is a Stripe "Restricted Business" — same reason Dwolla
# declined TOV earlier). Payliance is built for consumer/commercial lenders directly —
# account pending approval as of 2026-08-13 (sandbox credentials not issued yet).
# Reference: Payliance "ACH+RCC API Reference v1" (sandbox.api.payliance.com), see
# lib/payliance.ts. No self-serve signup — Sales/Implementations issues separate
# Staging and Production Bearer keys once the account is approved.
PAYLIANCE_SECRET_KEY=
# "production" switches the base URL to api.payliance.com; anything else (including
# unset) uses staging.api.payliance.com.
PAYLIANCE_ENVIRONMENT=staging

# Bank linking is just Plaid Auth (already in /apply) — Payliance's Debit/Credit calls
# carry the borrower's routing/account number directly, no separate vendor-specific
# linking step needed (unlike Stripe's Financial Connections). No webhook exists on
# Payliance's side either — status is polled via /api/payliance/status (see
# lib/payliance.ts retrieveTransaction).

# LoanDisk repayment method + collector used when auto-posting a confirmed Payliance
# repayment (see lib/loandisk.ts createRepayment). Repayment methods are branch-scoped
# (Consumer ≠ Commercial IDs); collectors are shared. Create "ACH - Payliance" under
# Admin → Loans → Loan Repayment Methods on each branch if these IDs ever need
# recreating, then update the two values below.
LOANDISK_REPAYMENT_METHOD_ACH_CONSUMER=
LOANDISK_REPAYMENT_METHOD_ACH_COMMERCIAL=
LOANDISK_COLLECTOR_SYSTEM_GENERATED=

# Staff panel (/admin/payliance) — a single shared password gate, not a full accounts
# system (see lib/staff-auth.ts). Change this to something real before go-live; the
# value here is a local-dev placeholder only.
STAFF_PANEL_PASSWORD=
